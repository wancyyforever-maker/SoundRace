\f0\fs24 \cf0 package com.example.soundrace\
\
import android.annotation.SuppressLint\
import android.bluetooth.BluetoothAdapter\
import android.bluetooth.BluetoothDevice\
import android.bluetooth.BluetoothServerSocket\
import android.bluetooth.BluetoothSocket\
import java.io.BufferedReader\
import java.io.IOException\
import java.io.InputStreamReader\
import java.io.OutputStream\
import java.util.Locale\
import java.util.UUID\
\
/**\
 * \uc0\u34013 \u29273 \u32463 \u20856  SPP \u36890 \u36947 \u12290 \u40614 \u20811 \u39118 \u31471 \u36830 \u25509 \u20027 \u26426 \u65292 \u25345 \u32493 \u21457 \u36865 \u19968 \u34892 \u19968 \u34892 \u30340 \u20998 \u36125 \u20540 \u12290 \
 * \uc0\u27880 \u24847 \u65306 \u36825 \u37324 \u20256 \u36755 \u30340 \u26159 \u20998 \u36125 \u25968 \u25454 \u65292 \u32780 \u19981 \u26159 \u38899 \u39057 \u27969 \u65292 \u24310 \u36831 \u20302 \u12289 \u21344 \u29992 \u23567 \u12290 \
 */\
class BtLink(private val adapter: BluetoothAdapter) \{\
\
    companion object \{\
        val SPP_UUID: UUID = UUID.fromString("00001101-0000-1000-8000-00805F9B34FB")\
    \}\
\
    @Volatile var connected = false\
    var onStatus: ((String) -> Unit)? = null\
    var onDb: ((Float) -> Unit)? = null\
\
    private var server: BluetoothServerSocket? = null\
    private var socket: BluetoothSocket? = null\
    private var out: OutputStream? = null\
\
    /** \uc0\u20027 \u26426 \u31471 \u65306 \u31561 \u24453 \u40614 \u20811 \u39118 \u31471 \u36830 \u25509 \u65292 \u24182 \u25345 \u32493 \u35835 \u21462 \u20998 \u36125  */\
    @SuppressLint("MissingPermission")\
    fun listen() \{\
        Thread \{\
            try \{\
                val srv = adapter.listenUsingRfcommWithServiceRecord("SoundRace", SPP_UUID)\
                server = srv\
                onStatus?.invoke("\uc0\u31561 \u24453 \u29609 \u23478 2\u30340 \u40614 \u20811 \u39118 \u31471 \u36830 \u25509 \'85")\
                val s = srv.accept()\
                srv.close()\
                socket = s\
                connected = true\
                onStatus?.invoke("\uc0\u9989  \u29609 \u23478 2\u24050 \u36830 \u25509 \u65292 \u21487 \u20197 \u24320 \u22987 ")\
                BufferedReader(InputStreamReader(s.inputStream)).useLines \{ lines ->\
                    lines.forEach \{ line -> line.toFloatOrNull()?.let \{ onDb?.invoke(it) \} \}\
                \}\
            \} catch (e: IOException) \{\
                onStatus?.invoke("\uc0\u34013 \u29273 \u24050 \u26029 \u24320 ")\
            \} finally \{\
                connected = false\
                onDb?.invoke(-100f) // \uc0\u26029 \u24320 \u21518 \u29609 \u23478 2\u35270 \u20026 \u23433 \u38745 \
            \}\
        \}.start()\
    \}\
\
    /** \uc0\u40614 \u20811 \u39118 \u31471 \u65306 \u36830 \u25509 \u24050 \u37197 \u23545 \u30340 \u20027 \u26426  */\
    @SuppressLint("MissingPermission")\
    fun connect(device: BluetoothDevice, done: (Boolean) -> Unit) \{\
        Thread \{\
            try \{\
                adapter.cancelDiscovery()\
                val s = device.createRfcommSocketToServiceRecord(SPP_UUID)\
                s.connect()\
                socket = s\
                out = s.outputStream\
                connected = true\
                done(true)\
            \} catch (e: IOException) \{\
                onStatus?.invoke("\uc0\u36830 \u25509 \u22833 \u36133 \u65306 \u35831 \u30830 \u35748 \u20004 \u21488 \u25163 \u26426 \u24050 \u37197 \u23545 \u65292 \u19988 \u20027 \u26426 \u22788 \u20110 \u31561 \u24453 \u29366 \u24577 ")\
                done(false)\
            \}\
        \}.start()\
    \}\
\
    fun send(db: Float) \{\
        val o = out ?: return\
        try \{\
            o.write(String.format(Locale.US, "%.1f\\n", db).toByteArray())\
        \} catch (e: IOException) \{\
            connected = false\
            onStatus?.invoke("\uc0\u34013 \u29273 \u24050 \u26029 \u24320 ")\
        \}\
    \}\
\
    fun close() \{\
        try \{\
            server?.close()\
            socket?.close()\
        \} catch (_: IOException) \{\
        \}\
        connected = false\
    \}\
\}}